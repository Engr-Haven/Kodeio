# Canonical public origin used for canonical tags, sitemap.xml, og:url and
# JSON-LD. Change this if the site moves to another domain.
VITE_SITE_URL=

# Where the /contact enquiry form POSTs its JSON payload.
# Leave empty until the form backend exists: with no endpoint the form falls
# back to handing the message to the visitor's own mail app, so no enquiry is
# silently dropped. Set it to your endpoint (and rebuild) to switch over.
VITE_CONTACT_ENDPOINT=